# Variables para docker compose (HU-23). Copia este archivo como .env en la
# raíz del repositorio y cambia los valores. .env está en .gitignore.
#
# Para generar valores aleatorios:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Contraseña del PostgreSQL del contenedor "db".
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_POSTGRES

# Llave de firma de los tokens JWT: mínimo 32 caracteres. La API no arranca
# con este valor de ejemplo.
JWT_SECRETO=CAMBIAR_POR_UN_VALOR_GENERADO_CON_TOKEN_HEX_32
