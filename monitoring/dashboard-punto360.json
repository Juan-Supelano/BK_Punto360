{
  "uid": "punto360",
  "title": "Punto360",
  "tags": [
    "punto360"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Módulo predictivo: cálculos por minuto",
      "description": "HU-26. Cálculos de /prediccion por tipo (ventas, inventario, mensual) y resultado (ok, sin_datos, error).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tipo, resultado) (rate(punto360_prediccion_calculos_total[5m])) * 60",
          "legendFormat": "{{tipo}} · {{resultado}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Módulo predictivo: duración p95",
      "description": "HU-26. Percentil 95 del tiempo que tarda cada cálculo predictivo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, tipo) (rate(punto360_prediccion_duracion_segundos_bucket[5m])))",
          "legendFormat": "{{tipo}}"
        }
      ]
    }
  ]
}