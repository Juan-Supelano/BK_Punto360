# Copia este archivo como .env (en esta carpeta) y cambia los valores.
# .env está en .gitignore: nunca se sube.

# Conexión a tu PostgreSQL local: pon TU contraseña.
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASENA@localhost:5432/cuadre_pos

# Llave de firma de los tokens JWT (HU-23): mínimo 32 caracteres. Genera una con
#   python -c "import secrets; print(secrets.token_hex(32))"
# La API no arranca con este valor de ejemplo.
JWT_SECRETO=CAMBIAR_POR_UN_VALOR_GENERADO_CON_TOKEN_HEX_32

# Opcionales (estos son sus valores por defecto).
# JWT_MINUTOS=480
# CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
